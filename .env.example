# clashIQ environment template
# Copy to .env.local for development. Never commit secrets.
# Environments: development | preview | production

NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (required). Local: docker compose up postgres
DATABASE_URL=postgresql://clashiq:clashiq@localhost:5432/clashiq?schema=public

# Redis (required for rate limits, pub/sub, queues). Local: docker compose up redis
REDIS_URL=redis://localhost:6379

# Session cookie signing. Generate: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Host bootstrap (used only by prisma seed)
SEED_HOST_EMAIL=host@clashiq.local
SEED_HOST_PASSWORD=change-this-host-password
SEED_PARTICIPANT_PASSWORD=change-this-participant-password

# Realtime WebSocket service (NOT the Next.js process)
REALTIME_URL=http://localhost:4001
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4001
REALTIME_SHARED_SECRET=replace-with-realtime-shared-secret

# Code judge (Judge0 CE). Never execute participant code in Next.js.
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=
JUDGE_QUEUE_NAME=clashiq-judge

# Object storage (S3-compatible). Local: MinIO. Production: R2/S3/MinIO.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=clashiq
S3_ACCESS_KEY=clashiq
S3_SECRET_KEY=clashiqsecret
S3_FORCE_PATH_STYLE=true
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000/clashiq

# LiveKit (self-hosted SFU for screen share). Optional until coding proctoring.
LIVEKIT_URL=http://localhost:7880
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Upload limits
MAX_UPLOAD_BYTES=2097152

# CORS extra origins (comma-separated). APP_URL is always allowed.
CORS_ORIGINS=

# Preview/production must use isolated databases — never point preview at production.
