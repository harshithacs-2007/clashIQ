# clashIQ environment template
# Copy to .env.local for development. Never commit secrets.
# Prisma CLI also reads `.env` if present (gitignored). You can duplicate the
# DATABASE_URL / DIRECT_URL lines there, or use `npm run db:migrate:deploy`
# which loads `.env.local`.

NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- PostgreSQL (REQUIRED for signup/login/sessions) ---
# Provider: Neon (free tier) — https://neon.tech
# Why Neon: serverless Postgres, Prisma-compatible (enums, JSON, FKs,
# transactions, unique indexes). No Redis/WebSocket/Judge0 on this host.
#
# Connection pooling: REQUIRED on Vercel (serverless). Use Neon's pooler
# hostname (`-pooler`) for DATABASE_URL. Use the non-pooler host for DIRECT_URL
# so `prisma migrate deploy` is not run through PgBouncer.
#
# Production and preview MUST use different Neon projects/branches.
#
# Local Docker example (no pooler; set both to the same URL):
DATABASE_URL=postgresql://clashiq:clashiq@localhost:5432/clashiq?schema=public
DIRECT_URL=postgresql://clashiq:clashiq@localhost:5432/clashiq?schema=public
#
# Neon production example (do not commit real values):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15
# DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Redis (optional for login; required for judging queues and realtime pub/sub)
REDIS_URL=redis://localhost:6379

# Session cookie signing material (keep >=32 chars). Session tokens themselves
# are random opaque values stored as SHA-256 hashes — not JWTs.
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Host bootstrap (prisma seed only — never NEXT_PUBLIC_)
SEED_HOST_EMAIL=host@clashiq.local
SEED_HOST_PASSWORD=change-this-host-password
SEED_PARTICIPANT_PASSWORD=change-this-participant-password

# Realtime WebSocket service (NOT hosted on Vercel)
REALTIME_URL=http://localhost:4001
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4001
REALTIME_SHARED_SECRET=replace-with-realtime-shared-secret

# Code judge (Judge0). Never execute participant code in Next.js/Vercel.
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=
JUDGE_QUEUE_NAME=clashiq-judge

# Object storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=clashiq
S3_ACCESS_KEY=clashiq
S3_SECRET_KEY=clashiqsecret
S3_FORCE_PATH_STYLE=true
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000/clashiq

# LiveKit (not on Vercel)
LIVEKIT_URL=http://localhost:7880
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

MAX_UPLOAD_BYTES=2097152
CORS_ORIGINS=
